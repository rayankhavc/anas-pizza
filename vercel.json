{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.anaspizzaoriginal.fr" }],
      "destination": "https://anaspizzaoriginal.fr/",
      "permanent": true
    },
    {
      "source": "/:chemin+",
      "has": [{ "type": "host", "value": "www.anaspizzaoriginal.fr" }],
      "destination": "https://anaspizzaoriginal.fr/:chemin+",
      "permanent": true
    }
  ]
}
